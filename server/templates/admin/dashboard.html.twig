{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title 'Обзор' %}

{% block main %}
    <div class="row g-3">
        {% for stat in stats %}
            <div class="col-sm-6 col-lg-4">
                <a class="card text-decoration-none h-100" href="{{ path(stat[2]) }}">
                    <div class="card-body">
                        <div class="text-muted">{{ stat[0] }}</div>
                        <div class="fs-2 fw-semibold">{{ stat[1] }}</div>
                    </div>
                </a>
            </div>
        {% endfor %}
    </div>
{% endblock %}
