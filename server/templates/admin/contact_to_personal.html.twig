{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}Вернуть в личные: {{ contact.name ?? '(без имени)' }}{% endblock %}

{% block main %}
<p>
    Контакт уберётся из семьи «{{ family.name }}» и станет личным контактом выбранного пользователя.
    С телефонов остальных членов семьи он удалится при следующей синхронизации, а у выбранного пользователя останется в телефонной книге.
</p>
<p class="text-muted">
    {{ contact.phones|join(', ') }}{{ contact.emails ? ' · ' ~ contact.emails|join(', ') }}
</p>

<form method="post" class="d-flex flex-wrap gap-2 align-items-center" style="max-width: 640px">
    <input type="hidden" name="_token" value="{{ csrf_token('to-personal' ~ contact.id) }}">
    <select name="user" class="form-select" required style="max-width: 380px">
        {% if members %}
            <optgroup label="Члены семьи «{{ family.name }}»">
                {% for u in members %}<option value="{{ u.id }}">{{ u.email }}</option>{% endfor %}
            </optgroup>
        {% endif %}
        {% if others %}
            <optgroup label="Другие пользователи (контакт появится у них только при восстановлении)">
                {% for u in others %}<option value="{{ u.id }}">{{ u.email }}</option>{% endfor %}
            </optgroup>
        {% endif %}
    </select>
    <button class="btn btn-primary">Вернуть в личные</button>
    <a class="btn btn-secondary" href="{{ path('admin_family_contact_index') }}">Отмена</a>
</form>
{% endblock %}
