{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    Телефонные книги пользователей{% if selectedUser %} — {{ selectedUser.email }}{% endif %}
{% endblock %}

{% block main %}
<style>
    .pb-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        object-fit: cover;
        flex-shrink: 0;
    }
    .pb-avatar-fallback {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: .95rem;
        background: var(--bs-secondary-bg, #e9ecef);
        color: var(--bs-secondary-color, #495057);
        flex-shrink: 0;
    }
    .pb-chip {
        display: inline-block;
        padding: .15rem .45rem;
        border-radius: .35rem;
        font-size: .82rem;
        background: var(--bs-tertiary-bg, #f8f9fa);
        border: 1px solid var(--bs-border-color, #dee2e6);
        margin: .1rem .2rem .1rem 0;
    }
</style>

{% if users is empty %}
    <div class="alert alert-info mb-0">
        Пользователи ещё не созданы. Сначала добавьте пользователя в разделе <a href="{{ path('admin_user_index') }}">Пользователи</a>.
    </div>
{% else %}
    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg-6">
                    <form method="get" action="{{ path('admin_phonebook_index') }}" class="d-flex gap-2 align-items-end">
                        <div class="flex-grow-1">
                            <label for="pb-user-select" class="form-label fw-semibold mb-1">Пользователь</label>
                            <select id="pb-user-select" name="user" class="form-select" onchange="this.form.submit()">
                                {% for row in users %}
                                    <option value="{{ row.user.id }}" {{ selectedUser and row.user.id == selectedUser.id ? 'selected' : '' }}>
                                        {{ row.user.email }} — {{ row.activeCount }} личн.{% if row.trashCount > 0 %}, {{ row.trashCount }} в корз.{% endif %}{% if row.user.family %} · семья «{{ row.user.family.name }}»{% endif %}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary">Открыть</button>
                    </form>
                </div>
                {% if selectedUser %}
                    <div class="col-lg-6 d-flex flex-wrap justify-content-lg-end gap-2">
                        <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_user_detail', {entityId: selectedUser.id}) }}">
                            <i class="fa fa-user me-1"></i>Карточка пользователя
                        </a>
                        {% if selectedUser.family %}
                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_family_detail', {entityId: selectedUser.family.id}) }}">
                                <i class="fa fa-people-roof me-1"></i>Семья: {{ selectedUser.family.name }}
                            </a>
                        {% endif %}
                        {% if counts.personalTotal > 0 %}
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_phonebook_export_vcf', {userId: selectedUser.id}) }}">
                                <i class="fa fa-download me-1"></i>Скачать .vcf (личные)
                            </a>
                        {% endif %}
                        {% if counts.familyTotal > 0 %}
                            <a class="btn btn-sm btn-primary" href="{{ path('admin_phonebook_export_vcf', {userId: selectedUser.id, family: 1}) }}">
                                <i class="fa fa-address-book me-1"></i>Скачать всю книгу (.vcf)
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% if selectedUser %}
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small">Личные контакты</div>
                        <div class="fs-4 fw-bold">{{ counts.personalTotal }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small">Доступны от семьи</div>
                        <div class="fs-4 fw-bold">{{ counts.familyTotal }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small">Всего активных в книге</div>
                        <div class="fs-4 fw-bold text-primary">{{ counts.effectiveTotal }}</div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card h-100">
                    <div class="card-body py-2 px-3">
                        <div class="text-muted small">Корзина / Устройства</div>
                        <div class="fs-4 fw-bold">{{ counts.trashTotal }} <span class="fs-6 text-muted fw-normal">/ {{ devices|length }} устр.</span></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <form method="get" action="{{ path('admin_phonebook_user', {userId: selectedUser.id}) }}" class="row g-2 align-items-end">
                    <input type="hidden" name="tab" value="{{ tab }}">
                    <div class="col-md-5">
                        <label for="pb-search" class="form-label small fw-semibold mb-1">Поиск в телефонной книге</label>
                        <input id="pb-search" type="search" name="q" value="{{ query }}" class="form-control" placeholder="Имя, номер телефона, email, дата рождения...">
                    </div>
                    <div class="col-md-4">
                        <label for="pb-device" class="form-label small fw-semibold mb-1">Фильтр по устройству</label>
                        <select id="pb-device" name="device" class="form-select">
                            <option value="">Все устройства пользователя ({{ devices|length }})</option>
                            {% for dRow in devices %}
                                <option value="{{ dRow.device.id }}" {{ selectedDevice and selectedDevice.id == dRow.device.id ? 'selected' : '' }}>
                                    {{ dRow.device }} — {{ dRow.syncedCount }} конт.
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-secondary flex-grow-1">Применить</button>
                        {% if query != '' or selectedDevice %}
                            <a class="btn btn-outline-secondary" href="{{ path('admin_phonebook_user', {userId: selectedUser.id, tab: tab}) }}">Сбросить</a>
                        {% endif %}
                    </div>
                </form>

                {% if devices is not empty %}
                    <div class="mt-3 pt-2 border-top d-flex flex-wrap gap-2 align-items-center">
                        <span class="small text-muted me-1">Устройства:</span>
                        {% for dRow in devices %}
                            {% set isCurrentDevice = selectedDevice and selectedDevice.id == dRow.device.id %}
                            <a href="{{ path('admin_phonebook_user', {userId: selectedUser.id, tab: tab, q: query ?: null, device: isCurrentDevice ? null : dRow.device.id}) }}"
                               class="badge text-decoration-none {{ isCurrentDevice ? 'bg-primary text-white' : 'bg-light text-dark border' }}">
                                <i class="fa fa-mobile-screen me-1"></i>{{ dRow.device }}
                                · {{ dRow.syncedCount }} конт.
                                · {% if dRow.device.lastSyncAt %}{{ dRow.device.lastSyncAt|date('d.m.Y H:i') }}{% else %}не синхр.{% endif %}
                            </a>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>

        <ul class="nav nav-tabs mb-3">
            <li class="nav-item">
                <a class="nav-link {{ tab == 'personal' ? 'active fw-semibold' : '' }}"
                   href="{{ path('admin_phonebook_user', {userId: selectedUser.id, tab: 'personal', q: query ?: null, device: selectedDevice ? selectedDevice.id : null}) }}">
                    Личные контакты
                    <span class="badge bg-secondary ms-1">
                        {{ counts.personalFiltered }}{% if counts.personalFiltered != counts.personalTotal %} из {{ counts.personalTotal }}{% endif %}
                    </span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'family' ? 'active fw-semibold' : '' }}"
                   href="{{ path('admin_phonebook_user', {userId: selectedUser.id, tab: 'family', q: query ?: null, device: selectedDevice ? selectedDevice.id : null}) }}">
                    Доступны от семьи
                    <span class="badge bg-secondary ms-1">
                        {{ counts.familyFiltered }}{% if counts.familyFiltered != counts.familyTotal %} из {{ counts.familyTotal }}{% endif %}
                    </span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link {{ tab == 'trash' ? 'active fw-semibold' : '' }}"
                   href="{{ path('admin_phonebook_user', {userId: selectedUser.id, tab: 'trash', q: query ?: null, device: selectedDevice ? selectedDevice.id : null}) }}">
                    Корзина
                    <span class="badge bg-secondary ms-1">
                        {{ counts.trashFiltered }}{% if counts.trashFiltered != counts.trashTotal %} из {{ counts.trashTotal }}{% endif %}
                    </span>
                </a>
            </li>
        </ul>

        {% if tab == 'family' %}
            {% set activeContacts = familyContacts %}
        {% elseif tab == 'trash' %}
            {% set activeContacts = trashContacts %}
        {% else %}
            {% set activeContacts = personalContacts %}
        {% endif %}

        {% if tab == 'trash' and selectedDevice %}
            <div class="alert alert-light border py-2 small">
                Фильтр по устройству ({{ selectedDevice }}) применяется к активным вкладкам; в корзине показаны все удалённые контакты пользователя.
            </div>
        {% endif %}

        {% if activeContacts is empty %}
            <div class="alert alert-secondary">
                {% if query != '' or (selectedDevice and tab != 'trash') %}
                    По текущим фильтрам контакты не найдены.
                {% elseif tab == 'family' %}
                    {% if selectedUser.family %}
                        Другие участники семьи «{{ selectedUser.family.name }}» пока не открыли общие контакты.
                    {% else %}
                        Пользователь {{ selectedUser.email }} не состоит в семье, поэтому семейные контакты отсутствуют.
                    {% endif %}
                {% elseif tab == 'trash' %}
                    Корзина пользователя {{ selectedUser.email }} пуста.
                {% else %}
                    У пользователя {{ selectedUser.email }} пока нет личных контактов.
                {% endif %}
            </div>
        {% else %}
            <div class="card">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Контакт</th>
                                <th>Телефоны</th>
                                <th>Email / ДР</th>
                                <th>Устройства пользователя</th>
                                <th>{% if tab == 'trash' %}Удалён{% else %}Обновлён{% endif %}</th>
                                <th class="text-end">Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for contact in activeContacts %}
                                {% set displayName = contact.name ?? '(без имени)' %}
                                {% set initials = displayName|slice(0, 1)|upper %}
                                {% set contactLinks = linksByContactId[contact.id] ?? [] %}
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            {% if contact.photoSha256 %}
                                                <img class="pb-avatar" src="{{ path('admin_contact_photo', {sha256: contact.photoSha256}) }}" alt="">
                                            {% else %}
                                                <span class="pb-avatar-fallback">{{ initials }}</span>
                                            {% endif %}
                                            <div>
                                                <div class="fw-semibold">
                                                    {{ displayName }}
                                                    <span class="badge bg-light text-muted border ms-1">r{{ contact.serverRevision }}</span>
                                                </div>
                                                <div class="small text-muted">
                                                    {% if tab == 'family' and contact.user %}
                                                        <span class="badge bg-info text-dark">от {{ contact.user.email }}</span>
                                                    {% elseif contact.family %}
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle">общий · {{ contact.family.name }}</span>
                                                    {% endif %}
                                                    <span class="font-monospace">{{ contact.uuid|slice(0, 8) }}</span>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        {% if contact.phones is empty %}
                                            <span class="text-muted">—</span>
                                        {% else %}
                                            {% for phone in contact.phones %}
                                                <div><span class="pb-chip font-monospace">{{ phone }}</span></div>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% for email in contact.emails %}
                                            <div class="small">{{ email }}</div>
                                        {% endfor %}
                                        {% if contact.birthday %}
                                            <div class="small text-muted"><i class="fa fa-cake-candles me-1"></i>{{ contact.birthday }}</div>
                                        {% endif %}
                                        {% if contact.emails is empty and not contact.birthday %}
                                            <span class="text-muted">—</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if contactLinks is empty %}
                                            <span class="small text-muted">Не привязан к устройствам</span>
                                        {% else %}
                                            {% for link in contactLinks %}
                                                <div class="small">
                                                    <span class="pb-chip">
                                                        <i class="fa fa-mobile-screen me-1"></i>{{ link.device }}
                                                        <span class="text-muted">· #{{ link.externalId }}</span>
                                                        {% if link.pendingSync %}
                                                            <span class="badge bg-warning text-dark ms-1" title="Есть изменения на сервере, не отправленные на это устройство">ожидает</span>
                                                        {% endif %}
                                                    </span>
                                                </div>
                                            {% endfor %}
                                        {% endif %}
                                    </td>
                                    <td class="small">
                                        {% if tab == 'trash' and contact.deletedAt %}
                                            <div>{{ contact.deletedAt|date('d.m.Y H:i') }}</div>
                                            <div class="text-muted">
                                                {{ contact.deletedOnServer ? 'удалён в админке' : 'удалён на телефоне' }}
                                                · до {{ contact.trashExpiresAt|date('d.m.Y') }}
                                            </div>
                                        {% else %}
                                            {{ contact.updatedAt|date('d.m.Y H:i') }}
                                        {% endif %}
                                    </td>
                                    <td class="text-end text-nowrap">
                                        {% if tab == 'trash' %}
                                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_trash_detail', {entityId: contact.id}) }}">
                                                Открыть в корзине
                                            </a>
                                        {% else %}
                                            <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_contact_detail', {entityId: contact.id}) }}">
                                                Карточка
                                            </a>
                                            {% if tab == 'personal' %}
                                                <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_contact_edit', {entityId: contact.id}) }}">
                                                    Изменить
                                                </a>
                                            {% endif %}
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        {% endif %}
    {% endif %}
{% endif %}
{% endblock %}
