<?xml version="1.0" encoding="utf-8"?>
<!-- Токен, файлы хранилища и соответствия контактов привязаны к устройству: ни облачный бэкап,
     ни перенос на новый телефон их не забирают. После переноса пользователь просто входит заново. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
