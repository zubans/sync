# Конфигурация серверного демона Argon4 на Ubuntu (/etc/argon-tunnel/server.env)

# Мастер-пароль (обязателен; должен совпадать с мастер-паролем на клиенте)
ARGON_MASTER_PASSWORD=change-me-master-password

# Сетевой интерфейс Ubuntu, на котором демон принимает зашифрованные пакеты
# (например: eth0, ens3; пусто — слушать на всех интерфейсах)
ARGON_LISTEN_INTERFACE=

# UDP-адрес и порт приёма пакетов
ARGON_LISTEN_ADDR=0.0.0.0:51820

# Имя создаваемого или оборачиваемого TUN-интерфейса на Ubuntu
ARGON_TUN_NAME=argon0

# Виртуальная подсеть туннеля (сервер получает .1, клиентам выдаются .2 .. .253)
ARGON_SUBNET=10.44.0.1/24

# Существующий сетевой интерфейс Ubuntu для оборачивания/маршрутизации (NAT MASQUERADE)
# (например: eth0; если пусто — маршрутизируется вся подсеть туннеля)
ARGON_OUT_INTERFACE=

# Включить ли автоматически IP forwarding и iptables MASQUERADE (1 = да, 0 = нет)
ARGON_ENABLE_NAT=1

# Параметры Argon2id (по умолчанию OWASP: 19456 КиБ = 19 МиБ, 2 прохода, 1 поток)
ARGON_TIME=2
ARGON_MEMORY_KIB=19456
ARGON_PARALLELISM=1

# MTU туннеля и маршруты, передаваемые клиенту
ARGON_MTU=1380
ARGON_DNS=1.1.1.1,8.8.8.8
ARGON_ROUTES=0.0.0.0/0
