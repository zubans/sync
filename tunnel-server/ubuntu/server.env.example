# Конфигурация серверного демона Argon4 на Ubuntu (/etc/argon-tunnel/server.env)

# Мастер-пароль (обязателен; должен совпадать с мастер-паролем на клиенте)
ARGON_MASTER_PASSWORD=change-me-master-password

# Сетевой интерфейс Ubuntu, на котором демон принимает зашифрованные пакеты
# (например: eth0, ens3; пусто — слушать на всех интерфейсах)
ARGON_LISTEN_INTERFACE=

# UDP-адрес и порт приёма пакетов
ARGON_LISTEN_ADDR=0.0.0.0:51820

# Имя создаваемого или оборачиваемого TUN-интерфейса на Ubuntu
ARGON_TUN_NAME=argon0

# Виртуальная подсеть туннеля (сервер получает .1, клиентам выдаются .2 .. .253)
ARGON_SUBNET=10.44.0.1/24

# Существующий сетевой интерфейс Ubuntu для оборачивания/маршрутизации (NAT MASQUERADE)
# (например: eth0; если пусто — маршрутизируется вся подсеть туннеля)
ARGON_OUT_INTERFACE=

# Включить ли автоматически IP forwarding и iptables MASQUERADE (1 = да, 0 = нет)
ARGON_ENABLE_NAT=1

# Параметры Argon2id (по умолчанию OWASP: 19456 КиБ = 19 МиБ, 2 прохода, 1 поток)
ARGON_TIME=2
ARGON_MEMORY_KIB=19456
ARGON_PARALLELISM=1

# MTU туннеля и маршруты, передаваемые клиенту
ARGON_MTU=1380
ARGON_DNS=1.1.1.1,8.8.8.8
ARGON_ROUTES=0.0.0.0/0

# Режим работы: tunnel (TUN-сервер, по умолчанию) или transit (L4 TCP/UDP транзит без TUN)
ARGON_MODE=tunnel

# Для режима transit: фиксированная цель host:port (обязательна при ARGON_TRANSIT_BLIND=1)
ARGON_TRANSIT_TARGET=

# Для режима transit: список разрешённых целей (host:port или CIDR[:port]) через запятую
ARGON_TRANSIT_ALLOW=

# Слепой passthrough-транзит без расшифровки (1 = да, 0 = нет; требует ARGON_TRANSIT_TARGET)
ARGON_TRANSIT_BLIND=0

# Версия протокола (5 = v5 с аутентифицированным padding по умолчанию, 4 = legacy v4)
ARGON_PROTOCOL_VERSION=5

# Разрешить приём legacy-рукопожатий v4 для совместимости (1 = да, 0 = только v5)
ARGON_ALLOW_V4=1

# Профиль распределения длины padding v5 (balanced, compact, wide) и внешний path MTU
ARGON_PADDING_PROFILE=balanced
ARGON_PATH_MTU=1500
# Поведенческие профили (включаются явным запросом клиента): разрешить ли video-call и его максимальную длительность
ARGON_BEHAVIOR_PROFILE=
ARGON_ALLOW_VIDEO_CALL=1
ARGON_VIDEO_CALL_MAX_DURATION=2h
# Таймаут неактивности сессии сервера (клиентский idle keepalive выбирается случайно в [16s..28s])
ARGON_SESSION_IDLE_TIMEOUT=10m
